# Copy to .env.local and fill in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marvel_fountains

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Used once by "npm run db:setup" to create the admin login (a random password is printed if empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
